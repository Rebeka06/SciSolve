<Application x:Class="SciSolve.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════
             COLOUR PALETTE  (Navy / White / Gray / Green)
             ═══════════════════════════════════════════ -->
        <Color x:Key="NavyDark">#0D1B2A</Color>
        <Color x:Key="NavyMid">#1B2A3B</Color>
        <Color x:Key="NavyLight">#243447</Color>
        <Color x:Key="NavyCard">#1E2D3D</Color>
        <Color x:Key="NavyBorder">#2E4057</Color>
        <Color x:Key="White">#FFFFFF</Color>
        <Color x:Key="WhiteDim">#D0DCE8</Color>
        <Color x:Key="WhiteMuted">#8BA0B4</Color>
        <Color x:Key="GrayLight">#3A4F63</Color>
        <Color x:Key="GrayBorder">#2A3D50</Color>
        <Color x:Key="GreenAccent">#2ECC71</Color>
        <Color x:Key="GreenDark">#27AE60</Color>
        <Color x:Key="GreenMuted">#1A3A28</Color>

        <SolidColorBrush x:Key="BrNavyDark"    Color="{StaticResource NavyDark}"/>
        <SolidColorBrush x:Key="BrNavyMid"     Color="{StaticResource NavyMid}"/>
        <SolidColorBrush x:Key="BrNavyLight"   Color="{StaticResource NavyLight}"/>
        <SolidColorBrush x:Key="BrNavyCard"    Color="{StaticResource NavyCard}"/>
        <SolidColorBrush x:Key="BrNavyBorder"  Color="{StaticResource NavyBorder}"/>
        <SolidColorBrush x:Key="BrWhite"       Color="{StaticResource White}"/>
        <SolidColorBrush x:Key="BrWhiteDim"    Color="{StaticResource WhiteDim}"/>
        <SolidColorBrush x:Key="BrWhiteMuted"  Color="{StaticResource WhiteMuted}"/>
        <SolidColorBrush x:Key="BrGrayLight"   Color="{StaticResource GrayLight}"/>
        <SolidColorBrush x:Key="BrGrayBorder"  Color="{StaticResource GrayBorder}"/>
        <SolidColorBrush x:Key="BrGreen"       Color="{StaticResource GreenAccent}"/>
        <SolidColorBrush x:Key="BrGreenDark"   Color="{StaticResource GreenDark}"/>
        <SolidColorBrush x:Key="BrGreenMuted"  Color="{StaticResource GreenMuted}"/>
        <SolidColorBrush x:Key="BrTransparent" Color="Transparent"/>

        <!-- ═══════════════════════════════════
             TYPOGRAPHY
             ═══════════════════════════════════ -->
        <FontFamily x:Key="FontMono">Consolas</FontFamily>
        <FontFamily x:Key="FontUI">Segoe UI</FontFamily>

        <!-- ═══════════════════════════════════
             BASE STYLES
             ═══════════════════════════════════ -->

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>

        <!-- Label  -->
        <Style TargetType="Label">
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteMuted}"/>
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="0"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"        Value="{StaticResource BrNavyDark}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrWhite}"/>
            <Setter Property="CaretBrush"        Value="{StaticResource BrWhite}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BrNavyBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="FontFamily"        Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Height"            Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrWhiteDim}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BrNavyDark}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrWhite}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrNavyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Margin"      Value="0,4"/>
        </Style>

        <!-- Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BrGrayBorder}"/>
            <Setter Property="Margin"     Value="0,8"/>
        </Style>

        <!-- ScrollViewer -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ── Standard navy button ── -->
        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background"        Value="{StaticResource BrNavyLight}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrWhite}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BrNavyBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="FontFamily"        Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Padding"           Value="18,8"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrNavyBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrNavyDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Green button (Excel actions) ── -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource NavyButton}">
            <Setter Property="Background"  Value="{StaticResource BrGreenDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrGreen}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrGreen}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Primary action button (Solve/Run) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavyButton}">
            <Setter Property="Background"  Value="#1A3A5C"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="FontSize"    Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#254B73"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Card panel ── -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BrNavyCard}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BrGrayBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="4"/>
            <Setter Property="Padding"          Value="12"/>
        </Style>

        <!-- ── Section header text ── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteMuted}"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
            <Setter Property="TextTransform" Value="Uppercase"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>

        <!-- ── Card title ── -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <!-- ── Log output text ── -->
        <Style x:Key="LogText" TargetType="TextBox">
            <Setter Property="Background"        Value="{StaticResource BrNavyDark}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="FontFamily"        Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="IsReadOnly"        Value="True"/>
            <Setter Property="TextWrapping"      Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn"     Value="True"/>
            <Setter Property="Height"            Value="Auto"/>
        </Style>

        <!-- ── DataGrid ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"           Value="{StaticResource BrNavyDark}"/>
            <Setter Property="Foreground"           Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="BorderBrush"          Value="{StaticResource BrGrayBorder}"/>
            <Setter Property="BorderThickness"      Value="1"/>
            <Setter Property="RowBackground"        Value="{StaticResource BrNavyDark}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BrNavyCard}"/>
            <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrGrayBorder}"/>
            <Setter Property="FontFamily"           Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"             Value="11.5"/>
            <Setter Property="CanUserAddRows"       Value="False"/>
            <Setter Property="CanUserDeleteRows"    Value="False"/>
            <Setter Property="CanUserResizeRows"    Value="False"/>
            <Setter Property="AutoGenerateColumns"  Value="False"/>
            <Setter Property="SelectionMode"        Value="Single"/>
            <Setter Property="HeadersVisibility"    Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource BrNavyMid}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrWhiteDim}"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrGrayBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"  Value="{StaticResource BrWhiteDim}"/>
        </Style>

        <!-- ── TabControl ── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"       Value="{StaticResource BrNavyDark}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background"       Value="{StaticResource BrNavyMid}"/>
            <Setter Property="Foreground"       Value="{StaticResource BrWhiteMuted}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="18,10"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Margin"           Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{StaticResource BrNavyCard}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrWhite}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="Border" Property="BorderBrush"
                                        Value="{StaticResource BrWhiteDim}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{StaticResource BrNavyLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Input row label ── -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="{StaticResource BrWhiteMuted}"/>
            <Setter Property="FontFamily"          Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment"       Value="Right"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
        </Style>

        <!-- ── Result highlight ── -->
        <Style x:Key="ResultBox" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BrGreenMuted}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Margin"          Value="0,8,0,0"/>
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource BrGreen}"/>
            <Setter Property="FontFamily"  Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

    </Application.Resources>
</Application>
